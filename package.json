    "compat:releases": "node scripts/list-dsh-releases.mjs",
    "audit:tokens": "node scripts/audit-theme-tokens.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:theme": "node scripts/smoke-theme.mjs",
    "smoke:compose": "node scripts/smoke-compose.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "eslint .",
    "smoke": "pnpm smoke:theme && pnpm smoke:compose",
    "verify:all": "pnpm compat:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm audit:tokens && pnpm verify:package && pnpm smoke && pnpm docs:check"
